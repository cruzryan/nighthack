# Copy to .env and fill in your key.
# The reconstruction agents need an OpenAI vision-capable key.
OPENAI_API_KEY=sk-...

# optional fallbacks (unused by default)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# model tiers (server maps fast/balanced/quality onto these families)
DEV_MODEL=gpt-4o-mini
QUALITY_MODEL=gpt-4o
